<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0"
             xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

    <persistence-unit name="SupermarketPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Managed Entity Classes -->
        <class>com.mycompany.quanlysieuthi.entity.Employee</class>
        <class>com.mycompany.quanlysieuthi.entity.Customer</class>
        <class>com.mycompany.quanlysieuthi.entity.Invoice</class>
        <class>com.mycompany.quanlysieuthi.entity.InvoiceDetail</class>
        <class>com.mycompany.quanlysieuthi.entity.ProductCategory</class>
        <class>com.mycompany.quanlysieuthi.entity.Product</class>
        <class>com.mycompany.quanlysieuthi.entity.Voucher</class>
        <class>com.mycompany.quanlysieuthi.entity.PurchaseReceipt</class>
        <class>com.mycompany.quanlysieuthi.entity.PurchaseReceiptDetail</class>
        <class>com.mycompany.quanlysieuthi.entity.InventoryReport</class>
        <class>com.mycompany.quanlysieuthi.entity.InventoryReportDetail</class>
        <class>com.mycompany.quanlysieuthi.entity.Payment</class>
        <class>com.mycompany.quanlysieuthi.entity.ReturnReceipt</class>
        <class>com.mycompany.quanlysieuthi.entity.Feedback</class>

        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <!-- Provider -->
            <property name="hibernate.connection.provider_class"
                      value="org.hibernate.hikaricp.internal.HikariCPConnectionProvider" />

            <!-- Driver -->
            <property name="jakarta.persistence.jdbc.driver"
                      value="org.postgresql.Driver" />

            <!-- Hibernate -->
            <property name="hibernate.dialect"
                      value="org.hibernate.dialect.PostgreSQLDialect" />
            <property name="hibernate.show_sql" value="true" />
            <property name="hibernate.format_sql" value="true" />
            <property name="hibernate.hbm2ddl.auto" value="none" />
        </properties>
    </persistence-unit>
</persistence>